# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your own values.
# Never commit the resulting .env file.
# ---------------------------------------------------------------------------

# ── Required ───────────────────────────────────────────────────────────────

# Telegram Bot API token issued by @BotFather.
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# MongoDB connection string.
MONGO_URI=mongodb://localhost:27017/story_bot

# Redis connection URL (used for BullMQ, caching, rate limiting and pub/sub).
REDIS_URL=redis://localhost:6379

# Telegram user ID of the owner. Always passes the admin guard and cannot be
# removed with /removeadmin. Get yours from a bot such as @userinfobot.
SUPER_ADMIN_ID=000000000

# MTProto API credentials from https://my.telegram.org -> API development tools.
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=your_api_hash_here

# ── Optional: runtime mode ─────────────────────────────────────────────────

# "prod" uses every active session in the pool.
# "dev"  restricts the pool to DEV_SESSION_PHONE only, so production sessions
#        are never touched during local development.
# Default: prod
APP_MODE=prod

# Required only when APP_MODE=dev. The sole session used for all downloads,
# in international format (e.g. +15551234567).
# Default: "" (empty)
DEV_SESSION_PHONE=

# ── Optional: concurrency and throttling ───────────────────────────────────

# Max concurrent BullMQ jobs handled by one worker process. Default: 10
# Keep this <= number_of_sessions * SESSION_MAX_CONCURRENCY.
WORKER_CONCURRENCY=10

# Max concurrent jobs a single MTProto session may handle. Default: 5
SESSION_MAX_CONCURRENCY=5

# Max jobs a single session may be picked for in a rolling 24-hour window.
# Sessions over the cap are skipped by the pool. Default: 200
SESSION_DAILY_LIMIT=200

# Minimum idle time in milliseconds between consecutive jobs for the same
# session, measured from job completion. Default: 5000
SESSION_COOLDOWN_MS=5000

# Random delay applied after each fresh MTProto download, in milliseconds,
# to spread out per-session request rate. Defaults: 200 / 800
REQUEST_JITTER_MS_MIN=200
REQUEST_JITTER_MS_MAX=800

# ── Optional: user rate limiting ───────────────────────────────────────────

# Max download requests a single user may make per window. Default: 5
RATE_LIMIT_MAX=5

# Length of the rate limit window in seconds. Default: 60
RATE_LIMIT_WINDOW_SECONDS=60

# ── Optional: caching ──────────────────────────────────────────────────────

# TTL in seconds for the Redis photo buffer cache. Videos are never cached
# in Redis. Default: 3600
CACHE_TTL_SECONDS=3600

# ── Optional: logging ──────────────────────────────────────────────────────

# Pino log level: trace | debug | info | warn | error | fatal. Default: info
LOG_LEVEL=info

# JSON array of Telegram channel IDs used as a media relay: files are uploaded
# there once to obtain a reusable Bot API file_id, then forwarded to the user.
# The bot must be an administrator in every channel listed here.
# Supergroup/channel IDs are negative and start with -100.
# Defaults to an empty list, which disables the relay — set this explicitly.
LOG_CHANNEL_IDS=[-1001111111111,-1002222222222]

# ── Optional: load testing (scripts/loadtest.ts only) ──────────────────────

# Target account for the load-test script. Not read by the bot or the worker.
# Point it only at an account you own. Default: durov
LOADTEST_TARGET_USERNAME=durov
