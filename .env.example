# Telegram bot token from @BotFather
BOT_TOKEN=REDACTED

# MongoDB connection URI (example: mongodb://127.0.0.1:27017/telegram_story_bot)
MONGO_URI=REDACTED

# Telegram user ID of the super admin (cannot be removed)
SUPER_ADMIN_ID=ADMIN_ID_REDACTED

# Telegram API ID from https://my.telegram.org
TELEGRAM_API_ID=API_ID_REDACTED

# Telegram API hash from https://my.telegram.org
TELEGRAM_API_HASH=REDACTED
